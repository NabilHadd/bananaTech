# Copia este archivo a .env y ajusta lo que haga falta:
#   cp .env.example .env
# El .env está en .gitignore; este .env.example sí se commitea.

# --- Postgres ---
POSTGRES_USER=bananatech
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=bananatech
# Puerto en el HOST. Se usa 5433 porque el 5432 suele estar ocupado
# por un Postgres instalado en el sistema.
POSTGRES_PORT=5433

# --- API ---
API_PORT=8000
DEBUG=true

# Sólo la necesitas para correr alembic o uvicorn desde el host, fuera de Docker.
# Dentro de compose la API no usa esta variable: se le inyecta una que apunta a "db".
DATABASE_URL=postgresql+asyncpg://bananatech:cambiame@localhost:5433/bananatech

# --- Estimación económica de viajes (CLP) ---
PRECIO_DIESEL_CLP_LITRO=1300
TARIFA_PEAJES_CLP_KM=50
COSTO_OPERACION_CLP_KM=300
TARIFA_VENTA_CLP_TON_KM=250
